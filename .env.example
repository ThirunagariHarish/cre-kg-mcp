# ─── Trading System — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Paper / Live Mode ────────────────────────────────────────────────────────
# MUST be explicitly set to false to go live. Requires human action.
PAPER_TRADING_MODE=true

# ─── Robinhood ────────────────────────────────────────────────────────────────
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_SECRET=        # Base32 TOTP secret for 2FA

# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ─── Server / Channel IDs (fill one per Discord source) ───────────────────────
# Vinod
DISCORD_VINOD_SERVER_ID=
DISCORD_VINOD_CHANNEL_ID=

# Albert
DISCORD_ALBERT_SERVER_ID=
DISCORD_ALBERT_CHANNEL_ID=

# Zabes (main server)
DISCORD_ZABES_SERVER_ID=
DISCORD_ZABES_CHANNEL_ID=

# ZAPs (Premium Options Trading server)
DISCORD_ZAPS_SERVER_ID=
DISCORD_ZAPS_CHANNEL_ID=

# ADI (Premium Alerts server)
DISCORD_ADI_SERVER_ID=
DISCORD_ADI_CHANNEL_ID=

# Pillow Swings server
DISCORD_PILLA_SERVER_ID=
DISCORD_PILLA_CHANNEL_ID=

# Everest server
DISCORD_EVEREST_SERVER_ID=
DISCORD_EVEREST_CHANNEL_ID=

# ─── Anthropic (LLM — Master Analyst inference) ───────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6    # or claude-opus-4-8 for production

# ─── Unusual Whales ───────────────────────────────────────────────────────────
UW_API_TOKEN=

# ─── Social APIs ─────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ─── Alerts ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true           # set to false for human-readable dev output

# ─── Dashboard ───────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_API_TOKEN=    # bearer token for dashboard API

# ─── Risk limits (global — individual analysts can be tighter) ────────────────
MAX_DAILY_LOSS_DOLLARS=500
MAX_POSITION_SIZE_DOLLARS=200
