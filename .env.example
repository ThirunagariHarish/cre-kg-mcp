SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- MCP transport (optional) ----------------------------------------
# Default: "stdio" (used by Claude Desktop). For remote agents over the
# internet via Cloudflare Tunnel, set to "streamable-http".
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1            # bind to localhost only; cloudflared forwards from here
# MCP_PORT=8080
# MCP_REMOTE_ALLOW_CYPHER=0     # set to 1 to expose cypher_query remotely (NOT recommended)
