{
  "_comment": "Replace placeholders before using. See SETUP.md.",
  "mcpServers": {
    "cre-kg": {
      "command": "<ABSOLUTE_PATH_TO_UV>",
      "args": [
        "run",
        "--project",
        "<ABSOLUTE_PATH_TO_REPO>",
        "python",
        "-m",
        "mcp_server.server"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "<YOUR_NEO4J_PASSWORD>"
      }
    }
  }
}
